# Copy to apps/gateway/.env (ignored by git), or set these in the service's environment.

# The .NET backend. Each client's token is checked against it.
ORYX_API_ORIGIN=https://erp.example.com

# Origins a browser page may connect from, comma separated. The installed app is served from the
# customer server's own origin; add http://127.0.0.1:5173 for development. "*" is refused.
ORYX_GATEWAY_ALLOWED_ORIGINS=https://erp.example.com

# The broker the backend publishes to. The same variables the oryx-next server uses.
RABBITMQ_HOST=
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=

# Optional. Where the gateway listens; put the HTTPS entry point in front of it and pass /realtime through.
# ORYX_GATEWAY_HOST=127.0.0.1
# ORYX_GATEWAY_PORT=4100

# Only for a development backend that is not on HTTPS yet.
# ORYX_GATEWAY_ALLOW_INSECURE=1
