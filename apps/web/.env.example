# Copy to apps/web/.env (ignored by git) and adjust. Read by `bun run dev:web`.

# Backend that /api requests are proxied to during development.
ORYX_DEV_API_ORIGIN=http://164.90.142.68:8086

# The address above is plain HTTP, so sign-in sends the password and tokens unencrypted.
# Remove this line once the backend is served over HTTPS (or point at a local backend).
ORYX_DEV_ALLOW_INSECURE_API=1

# The notification gateway (apps/gateway) during development; /realtime is proxied to it.
# Leave unset to run without live notifications: the app then checks for new ones every minute.
# ORYX_DEV_GATEWAY_ORIGIN=http://127.0.0.1:4100
