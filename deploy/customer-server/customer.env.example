# Customer-owned file: /etc/oryx-deploy/customer.env (root:oryx-deploy, mode 0640).
# Configure the existing backend once; releases never overwrite this file.
ORYX_API_ORIGIN=http://127.0.0.1:8086
ORYX_SITE_URL=http://oryx.customer.local
# Optional existing notification gateway origin; leave empty to return 503 for /realtime/.
ORYX_GATEWAY_UPSTREAM=
# Required only when ORYX_SITE_URL uses HTTPS. Existing trusted certificate files.
ORYX_TLS_CERT_FILE=
ORYX_TLS_KEY_FILE=

ORYX_DEPLOY_BRANCH=entrance-server
ORYX_GIT_REPOSITORY=git@github.com:kumateck/oryx-live-desktop.git
ORYX_DEPLOY_REPO=/opt/oryx/source
ORYX_DEPLOY_ROOT=/srv/oryx
ORYX_DEPLOY_STATE=/var/lib/oryx-deploy
ORYX_BUN=/var/lib/oryx-deploy/.bun/bin/bun
# Operator-confirmed minimum installed version across this customer's desktop clients.
ORYX_INSTALLED_SHELL_MIN_VERSION=0.1.0
ORYX_RETENTION_DAYS=30
ORYX_MAX_RELEASE_FAILURES=3
ORYX_BUILD_TIMEOUT_SECONDS=1800
# Optional root-owned executable. Receives a deployment event as JSON on stdin.
ORYX_ALERT_HOOK=
