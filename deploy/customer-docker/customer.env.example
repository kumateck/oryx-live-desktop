# Copy to /home/entrance/.config/oryx-live/customer.env; chmod 600. Never commit secrets.
ORYX_DEPLOY_BRANCH=entrance-server
ORYX_PUBLIC_PORT=3001
ORYX_API_UPSTREAM=http://oryx_api:5001
# Optional candidate compatibility evidence; preflight needs only the API. No exact Swagger hash.
# Genuine loopback request in a temporary Linux host-network probe; never a frontend origin.
ORYX_SWAGGER_ORIGIN=http://127.0.0.1:8080
DISCORD_WEBHOOK_URL=replace-with-customer-discord-webhook
# Default repository is the clone containing deploy.sh; state is outside the checkout.
ORYX_DEPLOY_STATE=/home/entrance/.local/state/oryx-live
ORYX_MIN_FREE_GB=10
ORYX_SHELL_FLOOR=0.1.0
ORYX_BIND_ADDRESS=0.0.0.0
ORYX_GATEWAY_UPSTREAM=disabled.invalid:4100
# Set https only when a trusted TLS edge fronts this container.
ORYX_PUBLIC_PROTO=auto
# Optional GitHub API read token for private repositories/rate limits. CI approval cannot be disabled.
GITHUB_TOKEN=
